# Roost — example environment configuration
# ------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# NOTE: the Flutter app itself needs no environment variables today
# (it runs off static demo data). These variables are for the API
# backend described in docs/BACKEND-README.md — set them up as you
# build the server.
# ------------------------------------------------------------------

# ── Server ──
PORT=4000
NODE_ENV=development
API_BASE_PATH=/api/v1

# ── Database ──
DATABASE_URL=postgres://user:password@localhost:5432/roost

# ── Auth (JWT + bcrypt) ──
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ── Remita payment gateway (sandbox) ──
REMITA_BASE_URL=https://remitademo.net
REMITA_MERCHANT_ID=
REMITA_API_KEY=
REMITA_SERVICE_TYPE_ID=
REMITA_WEBHOOK_SECRET=
